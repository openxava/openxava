INSERT INTO FORMULA VALUES('8D399FB4C0A80116081480A154F71F21','HTML TEST','<p>\u000a\u0009Esto es una prueba<br />\u000a\u0009de <em><strong>HTML</strong></em><br de="" />\u000a\u0009Dex oscuro <strong>negro</strong> y tr&aacute;gico <font color="#ff0000">rojo</font>, de muerte y <strong>dolor<br />\u000a\u0009Y largo</strong>,<span style="background-color: rgb(153, 204, 0);"> verde </span>y <font color="#993300"><strong>marr&oacute;n</strong></font> como los <em>ojitos</em> del <font size="5">mundo</font>.<br />\u000a\u0009&nbsp;</p>\u000a')
INSERT INTO FORMULA VALUES('ff80808231281e6501312820053d0000','L''AJUNTAMENT','L''Ajuntament')
INSERT INTO FORMULA VALUES('ff8081818f529a9d018f529b3af10000','GREAT FORMULA','<p>The recipe for the great formula is: "</p>\u000a<p>I have always argued that recipes are not so important. I firmly believe that cooking is an art, a form of personal expression that goes beyond following step-by-step instructions. Recipes can be useful as guides, but the real magic happens when you dare to experiment, to try new flavors and textures, to personalize each dish according to your taste. After all, every cook has their own unique touch.</p>\u000a')
INSERT INTO FORMULA VALUES('ff8081818fdd9c6e018fdda5af410002','JAVA RECIPE','<pre>    @ManyToOne\u000a    @JoinColumn(name = "ResourceSubType")\u000a    @DescriptionsList(descriptionProperties="resourcetypename,resourcesubtypeunit", condition="${resourcetype.resourcetypename}=''Livestock''")\u000a    private ResourceSubType resourceSubType;\u000a</pre>')
