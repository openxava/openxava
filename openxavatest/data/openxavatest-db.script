CREATE TRIGGER XAVATEST.CHECK_LENGTH_BEFORE_INSERT BEFORE INSERT ON XAVATEST.ARTICLE REFERENCING NEW ROW AS NEWROW FOR EACH ROW BEGIN ATOMIC IF LENGTH(NEWROW.DESCRIPTION)<5 THEN SIGNAL SQLSTATE'45000'SET MESSAGE_TEXT='Description length must be at least 5';END IF;END
