<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Invoice" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="535" columnSpacing="0" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<import>java.util.*</import>
	<import>net.sf.jasperreports.engine.*</import>
	<import>net.sf.jasperreports.engine.data.*</import>
	<parameter name="number" forPrompting="false" class="java.lang.String"/>
	<parameter name="date" forPrompting="false" class="java.lang.String"/>
	<parameter name="customer" forPrompting="false" class="java.lang.String"/>
	<parameter name="address" forPrompting="false" class="java.lang.String"/>
	<parameter name="sum" forPrompting="false" class="java.math.BigDecimal"/>
	<parameter name="vat" forPrompting="false" class="java.math.BigDecimal"/>
	<parameter name="total" forPrompting="false" class="java.math.BigDecimal"/>
	<field name="quantity" class="java.lang.Integer"/>
	<field name="product.description" class="java.lang.String"/>
	<field name="unitPrice" class="java.math.BigDecimal"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<pageHeader height="124">
		<element kind="staticText" x="396" y="3" width="54" height="15">
			<text><![CDATA[Invoice Nº]]></text>
		</element>
		<element kind="staticText" x="42" y="11" width="147" height="21" fontSize="18.0">
			<text><![CDATA[OpenXava Team]]></text>
		</element>
		<element kind="staticText" x="17" y="36" width="191" height="13">
			<text><![CDATA[Valencia - Spain - Europe - The World]]></text>
		</element>
		<element kind="rectangle" x="306" y="29" width="222" height="90" stretchType="NoStretch" radius="5"/>
		<element kind="staticText" x="316" y="38" width="64" height="13" pdfFontName="Helvetica-Bold" bold="true">
			<text><![CDATA[CUSTOMER]]></text>
		</element>
		<element kind="textField" x="0" y="104" width="284" height="13" evaluationTime="Now" blankWhenNull="false" pdfFontName="Helvetica-Oblique" italic="true">
			<expression><![CDATA[$P{date}]]></expression>
		</element>
		<element kind="textField" x="316" y="59" width="202" height="13" evaluationTime="Now" blankWhenNull="false">
			<expression><![CDATA[$P{customer}]]></expression>
		</element>
		<element kind="textField" x="316" y="86" width="202" height="13" evaluationTime="Now" blankWhenNull="false">
			<expression><![CDATA[$P{address}]]></expression>
		</element>
		<element kind="textField" x="451" y="3" width="75" height="14" evaluationTime="Now" blankWhenNull="false">
			<expression><![CDATA[$P{number}]]></expression>
		</element>
	</pageHeader>
	<columnHeader height="30">
		<element kind="rectangle" x="1" y="1" width="533" height="28" backcolor="#CCCCCC" stretchType="NoStretch"/>
		<element kind="staticText" x="11" y="11" width="65" height="14" pdfFontName="Helvetica-Bold" bold="true">
			<text><![CDATA[Quantity]]></text>
		</element>
		<element kind="staticText" x="95" y="11" width="58" height="12" pdfFontName="Helvetica-Bold" bold="true">
			<text><![CDATA[Product]]></text>
		</element>
		<element kind="staticText" x="304" y="11" width="77" height="16" pdfFontName="Helvetica-Bold" bold="true">
			<text><![CDATA[Unit price]]></text>
		</element>
		<element kind="staticText" x="450" y="11" width="48" height="15" pdfFontName="Helvetica-Bold" bold="true">
			<text><![CDATA[Amount]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="26">
			<element kind="textField" x="9" y="4" width="59" height="14" evaluationTime="Now" blankWhenNull="false" hTextAlign="Right">
				<expression><![CDATA[$F{quantity}]]></expression>
			</element>
			<element kind="textField" x="95" y="4" width="189" height="17" evaluationTime="Now" blankWhenNull="false">
				<expression><![CDATA[$F{product.description}]]></expression>
			</element>
			<element kind="textField" x="298" y="4" width="89" height="12" pattern="#,##0.00" evaluationTime="Now" blankWhenNull="false" hTextAlign="Right">
				<expression><![CDATA[$F{unitPrice}]]></expression>
			</element>
			<element kind="textField" x="432" y="4" width="91" height="13" pattern="#,##0.00" evaluationTime="Now" blankWhenNull="false" hTextAlign="Right">
				<expression><![CDATA[$F{amount}]]></expression>
			</element>
			<element kind="line" x="1" y="24" width="533" height="1" stretchType="NoStretch"/>
		</band>
	</detail>
	<summary height="76">
		<element kind="staticText" x="382" y="15" width="31" height="13" pdfFontName="Helvetica-Bold" bold="true">
			<text><![CDATA[SUM]]></text>
		</element>
		<element kind="staticText" x="382" y="32" width="32" height="13" pdfFontName="Helvetica-Bold" bold="true">
			<text><![CDATA[V.A.T.]]></text>
		</element>
		<element kind="staticText" x="382" y="54" width="49" height="13" pdfFontName="Helvetica-Bold" bold="true">
			<text><![CDATA[TOTAL]]></text>
		</element>
		<element kind="textField" x="432" y="15" width="91" height="14" pattern="#,##0.00" evaluationTime="Now" blankWhenNull="false" hTextAlign="Right">
			<expression><![CDATA[$P{sum}]]></expression>
		</element>
		<element kind="textField" x="432" y="32" width="91" height="13" pattern="#,##0.00" evaluationTime="Now" blankWhenNull="false" hTextAlign="Right">
			<expression><![CDATA[$P{vat}]]></expression>
		</element>
		<element kind="textField" x="432" y="54" width="91" height="13" pattern="#,##0.00" evaluationTime="Now" blankWhenNull="false" pdfFontName="Helvetica-Bold" bold="true" hTextAlign="Right">
			<expression><![CDATA[$P{total}]]></expression>
		</element>
	</summary>
</jasperReport>
